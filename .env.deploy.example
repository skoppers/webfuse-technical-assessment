# Copy to .env.deploy (gitignored). Loaded by scripts/deploy-extension.sh.
REST_KEY=rk_xxxxxxxxxxxxxxxx     # Space REST key (or ck_ company key). SECRET.
SPACE_ID=1234                    # Studio URL: https://webfuse.com/studio/spaces/<SPACE_ID>/
WEBFUSE_HOST=surfly.online         # host the space lives on (webfuse.com / surfly.online / us.webfuse.com / custom domain)
#STORAGE_APP=123                 # only needed if the space has >1 storage app
#EXT_ID=5678                     # optional; auto-resolved by manifest name
#REFRESH=true
